{
  "name": "desk-health-ai",
  "productName": "DeskHealth AI",
  "version": "0.5.0",
  "description": "Posture (slouching) & eye strain monitor - BSCS FYP S26CS034, University of Central Punjab",
  "main": "electron/main.js",
  "type": "commonjs",
  "author": "S26CS034 - M. Umair Khushnood, M. Ahsan Rasool, Saim Rafaqat",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "build:engine": "python scripts/build_engine.py",
    "dist": "npm run build:ui && npm run build:engine && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build:ui && npm run build:engine && electron-builder --mac",
    "test:engine": "python -m pytest engine/tests -q"
  },
  "build": {
    "appId": "pk.edu.ucp.deskhealthai",
    "productName": "DeskHealth AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine-dist/deskhealth-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "DeskHealth-AI-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeskHealth AI"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness",
      "extendInfo": {
        "NSCameraUsageDescription": "DeskHealth AI uses the camera to check your posture. Video never leaves your computer."
      }
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "dependencies": {}
}
